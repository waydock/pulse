    "uptime",
    "heartbeat",
    "healthcheck",
    "watchdog",
    "restart",
    "process",
    "cli"
  ],
  "license": "MIT",
  "author": { "name": "Waydock", "url": "https://waydock.ai" },
  "homepage": "https://waydock.ai/docs/pulse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waydock/pulse.git",
    "directory": "packages/agent"
  },
  "bugs": { "url": "https://github.com/waydock/pulse/issues" },
  "type": "module",
  "bin": { "pulse": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": { "build": "tsc -p tsconfig.json", "test": "vitest run" },
  "dependencies": {
