  "keywords": [
    "waydock",
    "pulse",
    "monitoring",
    "heartbeat",
    "schema",
    "zod",
    "types"
  ],
  "license": "MIT",
  "author": { "name": "Waydock", "url": "https://waydock.ai" },
  "homepage": "https://waydock.ai/docs/pulse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waydock/pulse.git",
    "directory": "packages/core"
  },
  "bugs": { "url": "https://github.com/waydock/pulse/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": { "build": "tsc -p tsconfig.json" },
